rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'language', 'createdAt', 'lastActivityAt'])
        && request.resource.data.keys().hasOnly(['ownerId', 'language', 'createdAt', 'lastActivityAt'])
        && request.resource.data.language in ['en', 'kn', 'te', 'hi']
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'language', 'createdAt', 'lastActivityAt'])
        && request.resource.data.keys().hasOnly(['ownerId', 'language', 'createdAt', 'lastActivityAt'])
        && request.resource.data.language == resource.data.language
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastActivityAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt']);
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /prescriptions/{prescriptionId} {
      function validPrescription(data) {
        return data.keys().hasOnly(['doctor_name', 'prescription_date', 'medicines', 'other_instructions', 'status', 'ownerId', 'createdAt', 'updatedAt'])
          && data.status == 'verified'
          && data.medicines is list
          && data.medicines.size() > 0
          && data.medicines.size() <= 30
          && data.ownerId is string;
      }
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validPrescription(request.resource.data);
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validPrescription(request.resource.data);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
