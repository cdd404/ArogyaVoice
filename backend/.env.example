# Copy to backend/.env and enter fresh provider keys locally. Never commit this file.
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=qwen/qwen3.8-27b
GNANI_API_KEY=replace_with_your_rotated_gnani_key
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional; set these if Tesseract is not on PATH or its language data is elsewhere.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata
